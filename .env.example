# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올라가지 않는다.

# Claude API 키 (https://platform.claude.com 에서 발급)
ANTHROPIC_API_KEY=

# claude = API 키(유료) / claude-code = 로그인한 Claude Code 구독(API 비용 없음) / fake = 테스트용 가짜 초안
DRAFTER=claude
DRAFT_MODEL=claude-opus-5-5
# low | medium | high
DRAFT_EFFORT=medium
DRAFT_CONCURRENCY=3
# 평가를 재현할 때만: 이 시각을 "지금"으로 쓴다 (예: 2026-10-21T15:30:00+09:00)
EVAL_NOW=

# 직원이 직접 답을 쓸 때 건당 걸리는 시간(분). 실제로 재서 넣으면 지표 화면에 절감 시간이 나온다.
BASELINE_MINUTES_PER_REPLY=

PORT=3000
DB_FILE=data/app.db
# 관리자 화면을 띄워 둔 동안 새 글을 확인하는 간격(초). 0이면 "지금 확인" 버튼으로만 가져온다. 최소 10초.
AUTO_SYNC_SECONDS=60
# 목업 시연용: 확인할 때마다 글을 이만큼씩만 더 내놓는다(알림이 한 건씩 오는 모습). 0이면 처음부터 모두.
MOCK_DRIP=0

# mock | api
CAFE24_MODE=mock
# 아래는 CAFE24_MODE=api 일 때만 필요하다. README의 "실제 카페24 연결" 참고.
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# 개발자센터 앱 설정의 Redirect URI와 글자 하나까지 같아야 한다 (scripts/cafe24-auth.ts)
CAFE24_REDIRECT_URI=
CAFE24_BOARD_NO=
# 상품 후기 게시판 번호. 비워 두면 후기는 가져오지 않는다.
CAFE24_REVIEW_BOARD_NO=
CAFE24_TOKEN_FILE=data/cafe24-token.json
CAFE24_REPLY_WRITER=CS팀
# 직원이 카페24 관리자 화면에서 직접 댓글을 달 때 쓰는 이름(쉼표로 여럿). 이 이름의 댓글은 고객 댓글로 가져오지 않는다.
CAFE24_STAFF_WRITERS=
CAFE24_CLIENT_IP=127.0.0.1

# 관리자 화면을 열 주소. 기본은 이 컴퓨터에서만(127.0.0.1). 같은 망의 다른 기기에서 열려면 0.0.0.0(인증이 없으니 주의).
HOST=127.0.0.1
# HOST=0.0.0.0으로 열 때 이 화면을 부를 이름(쉼표로 여럿, 예: 192.168.0.10). 비우면 이름 검사를 하지 않는다.
ALLOWED_HOSTS=

# 불만 사유 리포트(docs/COMPLAINTS.md). 카페24는 GET만 하고 쇼핑몰에는 쓰지 않는다.
# rules=규칙만, claude-code=규칙 + 로그인한 Claude Code(구독). 비우면 DRAFTER=claude-code일 때 claude-code, 아니면 rules.
# API 키(유료) 경로는 쓰지 않는다.
COMPLAINT_CLASSIFIER=
# 매일 몇 시(한국 시각) 이후에 만들지. off면 자동으로 만들지 않는다(관리자 화면 "지금 만들기"·npm run complaints로만).
COMPLAINT_REPORT_HOUR=9
# 시험 글 파일로 리포트를 만들어 볼 때만(예: data/complaint-eval/dev.json). 비우면 카페24(또는 목업)를 읽는다.
COMPLAINT_SOURCE=
